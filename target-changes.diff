+pub fn recexpr_to_pii(
+    egraph: &EGraph<TensorOp, TensorInfo>,
+    expr: &RecExpr<TensorOp>,
+    hbm_offsets: &Vec<(Option<Id>, i32)>,
+) -> PiiGraph {
+    let mut pii = PiiGraph::default();
+    let mut expr_to_pii: HashMap<Id, usize> = HashMap::new();
